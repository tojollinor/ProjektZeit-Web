ADMIN_USER=admin
ADMIN_PASSWORD=
PROJEKTZEIT_IMAGE=ghcr.io/tojollinor/projektzeit-web:latest
APP_PUBLIC_URL=https://projektzeit.example.de
DB_PASSWORD=
DB_ROOT_PASSWORD=
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
TZ=Europe/Berlin
# Eigenes Passwort mit mindestens 12 Zeichen oben eintragen.
# Passwörter mit $ oder # in einfache Anführungszeichen einschließen.
# Hinter HTTPS auf 1 setzen:
APP_SECURE_COOKIE=1
STARFACE_OAUTH_ALLOWED_ORIGINS=
INTEGRATION_KEY=
# STARFACE verwendet für ProjektZeit den öffentlichen OAuth-Client rest-client mit PKCE.
# Kein STARFACE_CLIENT_SECRET setzen.
# INTEGRATION_KEY nur setzen, wenn bisher ein eigener Schlüssel verwendet wurde.
# Sonst bleibt der automatisch erzeugte Schlüssel im Datenvolume.
# APP_PUBLIC_URL: tatsächliche Browser-Adresse inklusive https://, ohne Unterpfad.
# Für HTTP im LAN APP_SECURE_COOKIE=0 setzen.
# Drei unterschiedliche starke Passwörter für Admin, DB und DB-Root setzen.
# Weitere OAuth-Ursprünge nur bei Bedarf, kommagetrennt: https://idp.example.de
