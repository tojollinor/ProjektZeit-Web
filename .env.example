ADMIN_USER=admin
ADMIN_PASSWORD=
DEMO_MODE=0
PROJEKTZEIT_IMAGE=ghcr.io/tojollinor/projektzeit-web:latest
SEED_DEMO=0
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
TZ=Europe/Berlin
# Eigenes Passwort mit mindestens 12 Zeichen oben eintragen.
# Passwörter mit $ oder # in einfache Anführungszeichen einschließen.
# Hinter HTTPS auf 1 setzen:
APP_SECURE_COOKIE=0
# Optionaler Fernet-Schlüssel. Leer: automatisch im Datenvolume erzeugen.
INTEGRATION_KEY=
