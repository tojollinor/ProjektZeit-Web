<Window x:Class="ProjektZeit.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ProjektZeit" Width="520" Height="770" MinWidth="460" MinHeight="550" Background="#101722" FontFamily="Segoe UI" FontSize="14">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <StackPanel Orientation="Horizontal"><Image Source="logo.png" Width="40" Height="40" Margin="0,0,12,0"/><TextBlock Text="ProjektZeit" FontSize="27" FontWeight="Bold"/></StackPanel>
  <StackPanel x:Name="Controls">
   <TextBlock Text="PROJEKTZEIT WEBSERVER" Foreground="#98ABC6" Margin="0,18,0,3"/>
   <TextBlock x:Name="WebState" Text="● Nicht verbunden" Foreground="#FDBA74"/>
   <TextBlock Text="Serveradresse (HTTPS)"/><TextBox x:Name="Server"/>
   <TextBlock Text="Benutzername"/><TextBox x:Name="User"/>
   <TextBlock Text="Passwort"/><PasswordBox x:Name="Password"/>
   <WrapPanel><Button Content="Anmelden und speichern" Click="Login"/><Button Content="Abmelden" Click="Logout" Background="#334155"/></WrapPanel>
   <TextBlock Text="STARFACE" Foreground="#98ABC6" Margin="0,24,0,3"/>
   <TextBlock x:Name="PbxState" Text="● Nicht verbunden" Foreground="#FDBA74"/>
   <TextBlock Text="STARFACE-Adresse (HTTPS)"/><TextBox x:Name="Pbx"/>
   <Button Content="Mit STARFACE im Browser anmelden" Click="Connect"/>
   <Button Content="Verbindungsstatus prüfen" Click="Check" Background="#334155"/>
   <WrapPanel Margin="0,15,0,0"><Button Content="Arbeitsbeginn" Click="Begin"/><Button Content="Arbeitsende" Click="End"/><Button Content="Webübersicht" Click="OpenWeb" Background="#334155"/></WrapPanel>
  </StackPanel>
  <Button x:Name="Cancel" Content="Anmeldung abbrechen" Click="CancelLogin" Visibility="Collapsed" Background="#7C3947"/>
  <TextBlock x:Name="Status" Text="Bitte anmelden. Zugangsdaten werden nicht als Passwort gespeichert." TextWrapping="Wrap" Margin="0,18,0,0"/>
 </StackPanel></ScrollViewer>
</Window>
