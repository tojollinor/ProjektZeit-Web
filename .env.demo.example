# Nur für lokale Tests, nicht für eine Internetfreigabe!
# Legacy-Vorlage für direkten Python-/SQLite-Start, nicht für den MariaDB-Stack 0.7.
# Für Compose die aktuelle .env.example verwenden.
PROJEKTZEIT_IMAGE=ghcr.io/tojollinor/projektzeit-web:latest
ADMIN_USER=admin
ADMIN_PASSWORD=admin
DEMO_MODE=1
SEED_DEMO=1
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
TZ=Europe/Berlin
APP_SECURE_COOKIE=0
INTEGRATION_KEY=
